## Публичный URL сайта (без слэша на конце), используется в metadata/canonical/sitemap.
## 24.08.2026: easycalc.ru занят (чужой сайт с математическими калькуляторами).
## Нужен другой чистый домен 2-го уровня (.ru) — поддомены РСЯ не принимает.
## Кандидаты к проверке в регистраторе: zhizncalc.ru, easykalk.ru, calcprosto.ru
NEXT_PUBLIC_SITE_URL=https://example.ru

## Название бренда, используется в title template и footer
NEXT_PUBLIC_SITE_NAME=ТочныйРасчёт

## --- Запуск (домен + Метрика + Вебмастер + РСЯ) ---
## 1. Купить свободный .ru-домен 2-го уровня (Reg.ru / Timeweb / Beget), NS на хостинг или Vercel.
## 2. Скопировать этот файл в .env.local и подставить реальный NEXT_PUBLIC_SITE_URL.
## 3. Деплой: npx vercel --prod (или свой RU-хостинг с Node 20+).
## 4. Яндекс.Метрика: https://metrika.yandex.ru → счётчик на этот домен → ID сюда:
NEXT_PUBLIC_YANDEX_METRIKA_ID=

## 5. Яндекс.Вебмастер: https://webmaster.yandex.ru → добавить сайт → мета-тег verification:
NEXT_PUBLIC_YANDEX_VERIFICATION=

## 6. Google Search Console (по желанию) → мета-тег verification:
NEXT_PUBLIC_GOOGLE_VERIFICATION=

## 7. РСЯ: https://partner.yandex.ru → площадка на домене 2-го уровня → ID блока
##    (подключать после живого трафика; жёсткого порога «300 уников» в справке 2026 нет).
NEXT_PUBLIC_YANDEX_ADS_BLOCK_ID=

## --- Багрепорт (кнопка внизу справа → форма → письмо на почту через SMTP напрямую) ---
## Без NEXT_PUBLIC_ -эти переменные используются только на сервере (в app/api/bug-report),
## в браузер не попадают. Для Яндекс.Почты: Настройки → "Почтовые программы" → включить SMTP,
## затем создать отдельный пароль приложения (обычный пароль от почты для SMTP не подходит,
## нужна включённая двухфакторная аутентификация).
BUG_REPORT_SMTP_HOST=smtp.yandex.ru
BUG_REPORT_SMTP_PORT=465
BUG_REPORT_SMTP_USER=
BUG_REPORT_SMTP_PASSWORD=
BUG_REPORT_TO_EMAIL=rzhurakovskiy.webdev@yandex.ru
